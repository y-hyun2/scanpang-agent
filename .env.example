# ── LLM ────────────────────────────────────────────────────────────────────
# GPT-4o 호출. orchestrator intent_classifier + place_insight_agent 도슨트 해설
# + open_hours 정규화 등.
OPENAI_API_KEY=sk-...

# ── 위치 / 지도 / 길찾기 ────────────────────────────────────────────────────
TMAP_API_KEY=                  # SK TMAP — 보행자 경로 + POI 검색
KAKAO_REST_API_KEY=            # Kakao Local — 카테고리/키워드 검색, place_id 매칭
NAVER_CLIENT_ID=               # Naver Open API — store_details 풍부도 보강 + Papago 번역
NAVER_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=           # Google Places (영문 매장명) + Geocoding (영문 주소) — 다국어 지원용
VWORLD_API_KEY=                # VWorld — buildings 폴리곤 초기 적재 (운영 중엔 미사용)
VWORLD_DOMAIN=localhost

# ── 공공 데이터 ─────────────────────────────────────────────────────────────
TOUR_API_KEY=                  # TourAPI — 관광지 설명/이미지
STORE_API_KEY=                 # 소상공인 진흥공단 — 건물별 입점 매장
JUSO_API_KEY=                  # 도로명주소 → 건물관리번호
SEOUL_LOCKER_API_KEY=          # 서울시 지하철 물품보관함
PUBLIC_RESTROOM_API_KEY=       # 행정안전부 공중화장실 (data.go.kr)
KOREAEXIM_API_KEY=             # 한국수출입은행 — 실시간 환율
TAGO_API_KEY=                  # 국토부 TAGO — 지하철 실시간 운행

# ── DB / 캐시 ───────────────────────────────────────────────────────────────
# Supabase Postgres — place_info / store_details / buildings / user_preferences / inquiries
# 형식: postgresql://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DATABASE_URL=

# Redis — 대화 세션 (TTL 24h, 최근 10턴)
# - 로컬:          redis://localhost:6379/0
# - Docker Compose: docker-compose.yml 의 environment 가 redis://redis:6379/0 로 override
REDIS_URL=redis://localhost:6379/0
